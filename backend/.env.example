# MongoDB connection string
MONGO_URL=mongodb://localhost:27017
DB_NAME=sentient_tracker

# OpenAI API key for analysis
OPENAI_API_KEY=

# Legacy JWT secret for signing tokens (used when legacy auth is enabled)
JWT_SECRET=change-me

# Auth0 configuration (set for production auth)
AUTH0_DOMAIN=
AUTH0_AUDIENCE=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_IDS=  # Optional comma-separated list for multiple frontend SPAs

# Auth0 database connection for password reset emails
AUTH0_DB_CONNECTION=Username-Password-Authentication

# Optional: Auth0 Management API credentials (required only for automatic Auth0 identity deletion)
AUTH0_MGMT_CLIENT_ID=
AUTH0_MGMT_CLIENT_SECRET=
AUTH0_MGMT_AUDIENCE=

# Auth mode hardening
# If unset, legacy auth is auto-disabled on Railway/Auth0-configured environments.
ALLOW_LEGACY_AUTH=

# Basic in-memory auth rate limiting
AUTH_RATE_WINDOW_SECONDS=600
AUTH_LOGIN_RATE_LIMIT=60
AUTH_SIGNUP_RATE_LIMIT=30
AUTH_PASSWORD_RESET_RATE_LIMIT=20

# Basic in-memory community petition rate limiting
COMMUNITY_RATE_WINDOW_SECONDS=300
COMMUNITY_CREATE_RATE_LIMIT=15
COMMUNITY_SUPPORT_RATE_LIMIT=120
# Keep true for backward-compatible suggestions; set false to avoid surfacing studio tracked game names in public search
COMMUNITY_INCLUDE_TRACKED_SUGGESTIONS=true

# IGDB cover/logo lookup for community petitions (Twitch developer app credentials)
IGDB_TWITCH_CLIENT_ID=
IGDB_TWITCH_CLIENT_SECRET=
IGDB_REQUEST_TIMEOUT_SECONDS=15
IGDB_LOGO_CACHE_TTL_SECONDS=604800
IGDB_LOGO_RETRY_MISSING_SECONDS=86400
IGDB_LOGO_IMAGE_SIZE=cover_small

# Basic in-memory scan rate limiting
SCAN_RATE_WINDOW_SECONDS=300
SCAN_RATE_LIMIT=20

# CORS origins comma separated
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
# Optional host header allowlist. Use explicit domains in production.
ALLOWED_HOSTS=*
# Optional role-guard enforcement (disabled by default to avoid behavior changes)
ENFORCE_ROLE_GUARDS=false
STUDIO_ALLOWED_ROLES=studio,admin
PLAYER_ALLOWED_ROLES=player,studio,admin
# Optional custom claim containing role names in Auth0 access tokens
AUTH0_ROLE_CLAIM=

# Account deletion switch (disabled by default)
ACCOUNT_DELETE_ENABLED=false

